rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidElectronicsItem(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.sku is string && data.sku.size() > 0 && data.sku.size() <= 60 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 60 &&
             data.brand is string && data.brand.size() > 0 && data.brand.size() <= 60 &&
             (!('model' in data) || (data.model is string && data.model.size() <= 120)) &&
             data.quantity is int && data.quantity >= 0 && data.quantity <= 1000000 &&
             data.minStockThreshold is int && data.minStockThreshold >= 0 && data.minStockThreshold <= 100000 &&
             (data.costPrice is number && data.costPrice >= 0.0 && data.costPrice <= 1000000.0) &&
             (data.sellingPrice is number && data.sellingPrice >= 0.0 && data.sellingPrice <= 1000000.0) &&
             (!('condition' in data) || (data.condition is string && data.condition.size() <= 30)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 100)) &&
             (!('warrantyMonths' in data) || (data.warrantyMonths is int && data.warrantyMonths >= 0 && data.warrantyMonths <= 240)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidStockLog(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.itemId is string && data.itemId.size() > 0 && data.itemId.size() <= 128 &&
             data.itemName is string && data.itemName.size() > 0 && data.itemName.size() <= 120 &&
             data.changeAmount is int && data.changeAmount >= -1000000 && data.changeAmount <= 1000000 &&
             data.previousQuantity is int && data.previousQuantity >= 0 && data.previousQuantity <= 1000000 &&
             data.newQuantity is int && data.newQuantity >= 0 && data.newQuantity <= 1000000 &&
             data.reason is string && data.reason.size() > 0 && data.reason.size() <= 100 &&
             (!('staffName' in data) || (data.staffName is string && data.staffName.size() <= 100)) &&
             (!('staffRole' in data) || (data.staffRole is string && data.staffRole.size() <= 50)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidStaffMember(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.username is string && data.username.size() > 0 && data.username.size() <= 50 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.role is string && (data.role == 'OWNER' || data.role == 'MANAGER' || data.role == 'SALES' || data.role == 'CLERK') &&
             data.pin is string && data.pin.size() >= 3 && data.pin.size() <= 64 &&
             data.isActive is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      // Inventory Items subcollection
      match /items/{itemId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(itemId) &&
                         itemId == incoming().id &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['id', 'userId', 'name', 'sku', 'category', 'brand', 'quantity', 'minStockThreshold', 'costPrice', 'sellingPrice', 'createdAt', 'updatedAt']) &&
                         isValidElectronicsItem(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(itemId) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidElectronicsItem(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'sku', 'category', 'brand', 'model', 'quantity',
                           'minStockThreshold', 'costPrice', 'sellingPrice', 'condition',
                           'location', 'warrantyMonths', 'notes', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(itemId);
      }

      // Stock movement audit logs subcollection (append-only)
      match /stock_logs/{logId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(logId) &&
                         logId == incoming().id &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['id', 'userId', 'itemId', 'itemName', 'changeAmount', 'previousQuantity', 'newQuantity', 'reason', 'createdAt']) &&
                         isValidStockLog(incoming());

        allow update, delete: if false;
      }

      // Staff members & roles subcollection
      match /staff/{staffId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(staffId) &&
                         staffId == incoming().id &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['id', 'userId', 'username', 'displayName', 'role', 'pin', 'isActive', 'createdAt', 'updatedAt']) &&
                         isValidStaffMember(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(staffId) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidStaffMember(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'username', 'displayName', 'role', 'pin', 'isActive', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(staffId);
      }
    }
  }
}
